{
  "name": "lan-drop-local",
  "version": "0.1.2",
  "description": "LAN DROP — aplikasi desktop Rust (Tauri) untuk kirim file antar perangkat di Wi-Fi yang sama",
  "bin": {
    "lan-drop": "tui.js"
  },
  "files": [
    "tui.js",
    "main.js",
    "preload.js",
    "server/",
    "public/",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "tauri": "tauri",
    "start": "cargo run --release -p lan-drop",
    "server": "cargo run --release -p lan-drop -- --core",
    "check": "node scripts/check-js.js",
    "audit": "node scripts/audit-charset.js",
    "check:unused": "node scripts/check-unused-imports.js",
    "check:security": "node scripts/check-security.js",
    "check:identity": "node scripts/check-identity.js",
    "check:routing": "node scripts/check-routing.js",
    "check:routes": "node scripts/check-routes.js",
    "check:transcode": "node scripts/check-transcode.js",
    "check:autoapprove": "node scripts/check-autoapprove.js",
    "check:ack": "node scripts/check-ack.js",
    "smoke": "node scripts/smoke.js --url http://localhost:3000",
    "verify:qr": "node scripts/verify-qr.js --url http://localhost:3000",
    "verify:pwa": "node scripts/verify-pwa.js --url http://localhost:3000",
    "icons": "node scripts/generate-icons.js",
    "test": "node scripts/check-js.js && node scripts/check-i18n.js && node scripts/audit-charset.js && node scripts/check-unused-imports.js && node scripts/check-security.js && node scripts/check-identity.js && node scripts/check-routing.js && node scripts/check-discovery-rebind.js && node scripts/check-autoapprove.js && node scripts/check-ack.js && node scripts/check-settings.js && node scripts/check-dashboard.js && node scripts/check-dashboard-ago.js && node scripts/check-send-flow.js && node scripts/check-access.js && node scripts/check-transfer-integrity.js && node scripts/check-resume.js && npm run check:desktop",
    "check:dashboard-ago": "node scripts/check-dashboard-ago.js",
    "check:send-flow": "node scripts/check-send-flow.js",
    "check:settings": "node scripts/check-settings.js",
    "check:dashboard": "node scripts/check-dashboard.js",
    "check:i18n": "node scripts/check-i18n.js",
    "check-discovery-rebind": "node scripts/check-discovery-rebind.js",
    "check:access": "node scripts/check-access.js",
    "check:transfer-integrity": "node scripts/check-transfer-integrity.js",
    "check:resume": "node scripts/check-resume.js",
    "check:parity": "node scripts/check-parity.js",
    "check:rust-core": "node scripts/check-rust-core.js",
    "core:build": "cargo build --release --manifest-path rust/Cargo.toml -p lan-drop-core",
    "core": "cargo run --release --manifest-path rust/Cargo.toml -p lan-drop-core",
    "check:rust-hardening": "node scripts/check-rust-hardening.js",
    "core:test": "cargo test --release --manifest-path rust/Cargo.toml -p lan-drop-core",
    "test:core": "npm run core:build && npm run app:build && npm run core:lint && npm run core:test && npm run check:parity && npm run check:rust-core && npm run check:rust-hardening && npm run check:rust-ci && npm run check:desktop",
    "core:lint": "node scripts/core-lint.js",
    "check:rust-ci": "node scripts/check-rust-ci.js",
    "desktop": "cargo run --release -p lan-drop",
    "app:build": "cargo build --release --manifest-path rust/Cargo.toml -p lan-drop",
    "check:desktop": "node scripts/check-desktop.js",
    "bundle": "cd rust/app && npx tauri build",
    "bundle:linux": "cd rust/app && npx tauri build --bundles deb,rpm,appimage",
    "android:init": "cd rust/app && npx tauri android init",
    "android:apk": "bash scripts/android-apks.sh"
  },
  "keywords": [
    "lan",
    "file-transfer",
    "share-files",
    "local-network",
    "airdrop",
    "termux",
    "cli"
  ],
  "author": "Ahmad Zakariyah",
  "license": "ISC",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Godisheree/lan-drop-local.git"
  },
  "homepage": "https://github.com/Godisheree/lan-drop-local#readme",
  "bugs": {
    "url": "https://github.com/Godisheree/lan-drop-local/issues"
  },
  "overrides": {
    "body-parser": "^2.4.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  }
}
